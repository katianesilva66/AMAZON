* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --azul: #131921;
    --azul-claro: #232f3e;
    --laranja: #ff9900;
    --branco: #ffffff;
}

body {
    font-family: Arial, sans-serif;
    background: #f3f4f6;
    color: #222;
}

/* CABEÇALHO */

.cabecalho {
    background: var(--azul);
    color: var(--branco);
    padding: 20px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.logo h1 {
    font-size: 30px;
}

.logo span {
    font-size: 12px;
    letter-spacing: 2px;
}

.pesquisa {
    display: flex;
    flex: 1;
    max-width: 650px;
}

.pesquisa input {
    width: 100%;
    padding: 14px;
    border: none;
    font-size: 15px;
}

.pesquisa button {
    background: var(--laranja);
    border: none;
    padding: 14px 25px;
    font-weight: bold;
    cursor: pointer;
}

/* CATEGORIAS */

.categorias {
    background: var(--azul-claro);
    padding: 15px 5%;
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
}

.categorias a {
    color: white;
    text-decoration: none;
    font-size: 14px;
}

/* DESTAQUE */

.destaque {
    background: white;
    margin: 25px auto;
    padding: 60px 30px;
    width: 90%;
    text-align: center;
    border-radius: 8px;
}

.destaque h2 {
    font-size: 30px;
    margin-bottom: 15px;
}

.destaque p {
    color: #666;
    font-size: 17px;
}

/* PRODUTOS */

.produtos {
    width: 90%;
    margin: 35px auto;
}

.produtos h2 {
    margin-bottom: 20px;
    font-size: 24px;
}